{
  "title": "used-pc-judge: 중고 PC 매물 판정",
  "project": "..",
  "cwd": "{{project}}",
  "width": 92,
  "height": 28,
  "env": {"PYTHONPATH": "{{project}}"},
  "steps": [
    {"type": "comment", "text": "# 당근에서 복사한 매물 글을 넣으면 적정가를 판정"},
    {"type": "cmd", "run": "python -m usedpc judge examples/listing_sample.txt --no-questions", "show": "python -m usedpc judge listing.txt", "max_lines": 23},
    {"type": "pause", "seconds": 2}
  ]
}
