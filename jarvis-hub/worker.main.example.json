{
  "hub": "http://100.64.0.10:8800",
  "device": "main",
  "token": "CHANGE-ME-main-token-xxxxxxxxxx",
  "caps": ["gpu", "llm", "windows", "claude"],
  "concurrency": 1,
  "handlers": {
    "llm.chat": {"base_url": "http://127.0.0.1:8080/v1", "model": "local", "timeout": 300,
                 "files_dir": "C:/Users/me/JarvisInbox", "pdftotext": "C:/tools/poppler/bin/pdftotext.exe"},
    "shell.allowed": {
      "commands": {
        "backup": {"argv": ["robocopy", "C:/work", "{target}", "/MIR", "/NJH", "/NJS"], "timeout": 3600,
                   "fail_on_nonzero": false,
                   "params": {"target": {"choices": ["D:/backup", "E:/backup"], "default": "D:/backup"}}},
        "git_status": {"argv": ["git", "-C", "C:/work/myrepo", "status", "--short"], "timeout": 30}
      }
    },
    "claude.task": {"enabled": false, "command": ["claude", "-p", "{prompt}", "--output-format", "text"],
                    "repos": {"default": "C:/work/myrepo"}, "timeout": 1800}
  }
}
