{
  "timezone": "local",
  "out_dir": "out",
  "reject_text": "일어나면 해 드립니다",
  "speak": {"seconds": 60, "chars_per_sec": 5.0, "max_chars": 300, "intro": true},
  "weights": {"paper_butler": 1.0, "game_calendar": 1.0},
  "quiet_days": {
    "weekdays": [5, 6],
    "weights": {"game_calendar": 1.5, "community_briefing": 1.4, "claude_night": 0.7, "voice_journal": 0.8}
  },
  "sources": {
    "paper_butler": {"enabled": true, "mode": "auto", "db": "", "lookahead_days": 14, "overdue_days": 7, "refund_days": 14},
    "game_calendar": {"enabled": true, "mode": "auto", "state": "../game-calendar/state.json", "gamecal_config": ""},
    "cool_off": {"enabled": true, "mode": "auto", "data": "", "renewal_days": 3},
    "voice_journal": {"enabled": true, "mode": "auto", "db": ""},
    "claude_night": {"enabled": true, "projects_dir": "", "start_hour": 23, "end_hour": 9, "ignore_cwd": []},
    "jarvis": {"enabled": false, "url": "http://127.0.0.1:8800", "device": "s21", "token_env": "JARVIS_TOKEN",
               "watch_devices": ["5080"]},
    "sound_watch": {"enabled": true, "data_dir": "../sound-watch/data"},
    "community_briefing": {"enabled": true, "dir": "../community-briefing/out", "top": 3}
  },
  "notify": {
    "sidekick": {"url": "http://127.0.0.1:8765", "token_env": "SIDEKICK_TOKEN", "module": "morning-brief"},
    "ntfy": {"server": "https://ntfy.sh", "topic": "", "token_env": "NTFY_TOKEN", "priority": "default"}
  }
}
